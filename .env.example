# Database connection strings
# PostgreSQL 18 connection for the app runtime role (xiaoshuyin_app)
DATABASE_URL=

# PostgreSQL 18 connection for the migration role (xiaoshuyin_migrator)
MIGRATION_DATABASE_URL=

# Session token HMAC secret (minimum 16 characters)
SESSION_SECRET=

# Evidence hash pepper for HMAC-SHA256 of IP/UA (minimum 16 characters)
EVIDENCE_HASH_PEPPER=

# WeChat Mini Program app credentials
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# Test-only admin database connection (superuser, for test assertions bypassing RLS)
TEST_ADMIN_DATABASE_URL=

# Identity binding runtime (Slice 006) — required, no defaults
IDENTITY_BINDING_SECRET=
IDENTITY_BINDING_CONTEXT_TTL_SECONDS=
IDENTITY_BINDING_ATTEMPT_TTL_SECONDS=

# Case participant invitations (Slice 4) — required, no defaults
PARTICIPATION_INVITE_TTL_SECONDS=
PARTICIPATION_INVITE_TOKEN_SECRET=
